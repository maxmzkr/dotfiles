{
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "bifrost": {
      "disabled": false,
      "headers": {
        "Authorization": "Bearer ${cmd: jq -r .api_key ~/.config/bifrost/credentials.json}"
      },
      "url": "${cmd: jq -r .mcp_url ~/.config/bifrost/credentials.json}"
    },
    "github": {
      "disabled": false,
      "headers": {
        "Authorization": "Bearer ${cmd: gh auth token}"
      },
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "gopls": {
      "args": [
        "--workspace",
        "${CWD}",
        "--lsp",
        "gopls"
      ],
      "command": "mcp-language-server",
      "disabled": false
    }
  }
}
