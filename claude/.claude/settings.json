{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay --volume=49152 /usr/share/sounds/freedesktop/stereo/bell.oga 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux set -p -t \"$p\" @claude_state done \\; set -p -t \"$p\" @claude_since \"$(date +%s)\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay --volume=49152 /usr/share/sounds/freedesktop/stereo/window-attention.oga 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux set -p -t \"$p\" @claude_state permission \\; set -p -t \"$p\" @claude_since \"$(date +%s)\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S /home/max/.claude/hooks/git_events.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -S /home/max/.claude/hooks/skill_triggers.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux set -p -t \"$p\" @claude_state working \\; set -p -t \"$p\" @claude_since \"$(date +%s)\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S /home/max/.claude/hooks/git_events.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux set -p -t \"$p\" @claude_state idle \\; set -p -t \"$p\" @claude_since \"$(date +%s)\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*__(create|update)_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S /home/max/.claude/hooks/pr_body_check.py"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*__(create_or_update_file|push_files|merge_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S /home/max/.claude/hooks/commit_trailer_check.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=/home/max/.claude/hooks/bq_project_check.py; [ -f \"$f\" ] && python3 -S \"$f\"; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux if -F -t \"$p\" \"#{!=:#{@claude_state},working}\" \"set -p -t $p @claude_state working ; set -p -t $p @claude_since $(date +%s)\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux if -F -t \"$p\" \"#{!=:#{@claude_state},working}\" \"set -p -t $p @claude_state working ; set -p -t $p @claude_since $(date +%s)\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux set -p -t \"$p\" @claude_state done \\; set -p -t \"$p\" @claude_since \"$(date +%s)\" 2>/dev/null; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_TMUX_PANE:-$TMUX_PANE}\"; [ -n \"$p\" ] && tmux set -p -u -t \"$p\" @claude_state \\; set -p -u -t \"$p\" @claude_since 2>/dev/null; true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/max/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "light",
  "preferredNotifChannel": "notifications_disabled",
  "useAutoModeDuringPlan": true,
  "skipWorkflowUsageWarning": true
}
