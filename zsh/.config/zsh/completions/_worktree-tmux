#compdef worktree-tmux wt

# Completion for worktree-tmux command

# Check if we're in a git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    _message 'not in a git repository'
    return 1
fi

# For worktree-tmux, suggest existing worktree branches
local -a branches
branches=(${(f)"$(git worktree list --porcelain 2>/dev/null | awk '
    /^branch / {
        branch = substr($0, 8)
        gsub(/^refs\/heads\//, "", branch)
        print branch
    }
')"})

if (( ${#branches[@]} == 0 )); then
    _message 'no worktrees found'
    return 1
fi

_arguments '1: :->branch'

case $state in
    branch)
        _describe 'worktree branches' branches
        ;;
esac
